      "--retain-failures",
      "--require-read-submit"
    ],
    "arms": {
      "A": [
        "--mode closed_tool"
      ],
      "B": [
        "--mode indexed_interactive",
        "--indexed-tools symbol_search",
        "--tool-provider codenib.eval.benchmarks.agent_retrieval_bench_tools:CodeNibToolProvider",
        "--tool-provider-option workspace=<checkout dir>",
        "--tool-provider-option cache=<graph cache dir>",
        "--tool-provider-option retry_failed=false",
        "--max-index-results 10",
        "--max-index-observation-tokens 400"
      ],
      "C": [
        "--mode indexed_interactive",
        "--indexed-tools symbol_search,references",
        "--tool-provider codenib.eval.benchmarks.agent_retrieval_bench_tools:CodeNibToolProvider",
        "--tool-provider-option workspace=<checkout dir>",
        "--tool-provider-option cache=<graph cache dir>",
        "--tool-provider-option retry_failed=false",
        "--max-index-results 10",
        "--max-index-observation-tokens 400"
      ]
    },
    "prefix_report": "arb report-closed-tool-budget-curve --details details_<arm>.jsonl --keep-list pilot_samples.jsonl",
    "notes": "--require-read-submit is enabled in all three arms; its default stays off for other runs."
  },
