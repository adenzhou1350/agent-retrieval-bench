    "name": "CodeNib",
    "factory": "codenib.eval.benchmarks.agent_retrieval_bench_tools:CodeNibToolProvider",
    "source_access": "full-source: indexes built from a clean checkout at base_commit; hits limited to released files",
    "commit": "recorded in each run summary"
  },
  "analysis": {
    "primary": [
      "final File F1",
      "final any-gold",
      "any-gold read"
    ],
    "cost": [
      "tool calls",
      "index calls",
      "read tokens",
      "observation tokens",
      "model input and output tokens",
      "rejected submits, with their model turns and tokens",
      "earlier attempts of retried samples (prior_attempts), totalled apart",
      "index build seconds (per snapshot, reported separately)"
    ],
    "contrasts": {
      "B - A": "adding symbol_search, including its full-source information",
      "C - B": "adding references on top of symbol_search"
    },
    "intervals": "paired differences with a 95% percentile bootstrap that resamples repositories (all of a repository's selected samples together), 10,000 resamples",
    "slices": "per task and per dev/heldout label, descriptive only",
    "denominator": "all 60 selected samples in every arm, including unavailable indexes, failures, and budget exhaustion",
    "scope": "single model, single run per sample and arm; does not measure policy-run variability"
  },
